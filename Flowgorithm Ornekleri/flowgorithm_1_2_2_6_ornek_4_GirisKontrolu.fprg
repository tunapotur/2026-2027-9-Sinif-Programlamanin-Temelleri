    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sKey, kPass" type="String" array="False" size=""/>
            <assign variable="sKey" expression="&quot;1234&quot;"/>
            <output expression="&quot;&#350;ifrenizi Giriniz: &quot;" newline="True"/>
            <input variable="kPass"/>
            <if expression="sKey == kPass">
                <then>
                    <output expression="&quot;Sisteme Girer&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Sisteme G&#304;REMEZ!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
