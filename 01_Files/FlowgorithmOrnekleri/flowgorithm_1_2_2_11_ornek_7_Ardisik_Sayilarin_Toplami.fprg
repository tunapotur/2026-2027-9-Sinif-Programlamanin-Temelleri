<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="flowgorithm_1_2_2_8_ornek_7_Ardisik_Sayilarin_Toplami"/>
        <attribute name="authors" value="tuna"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-03 06:07:35 &#214;S"/>
        <attribute name="created" value="dHVuYTtXSU4xMVRVTkE7MjAyNi0xMC0wMzswNToxMDoxMyDDllM7MjQ5Ng=="/>
        <attribute name="edited" value="dHVuYTtXSU4xMVRVTkE7MjAyNi0xMC0wMzswNjowNzozNSDDllM7MTsyNjE1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sayac, toplam, n" type="Integer" array="False" size=""/>
            <assign variable="sayac" expression="1"/>
            <assign variable="toplam" expression="0"/>
            <output expression="&quot;n de&#287;erini girin: &quot;" newline="True"/>
            <input variable="n"/>
            <while expression="sayac &lt;= n">
                <assign variable="toplam" expression="toplam + sayac"/>
                <assign variable="sayac" expression="sayac + 1"/>
            </while>
            <output expression="&quot;Toplam : &quot;&amp;toplam" newline="True"/>
        </body>
    </function>
</flowgorithm>
