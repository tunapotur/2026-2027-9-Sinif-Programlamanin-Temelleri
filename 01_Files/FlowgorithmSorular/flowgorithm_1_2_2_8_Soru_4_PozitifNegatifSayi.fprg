    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sayi" type="Integer" array="False" size=""/>
            <output expression="&quot;Bir Tamsay&#305; Giriniz&quot;" newline="True"/>
            <input variable="sayi"/>
            <if expression="sayi == 0">
                <then>
                    <output expression="sayi&amp;&quot; Say&#305;s&#305; Girildi!&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="sayi &gt; 0">
                        <then>
                            <output expression="sayi&amp;&quot; Say&#305;s&#305; Pozitif Bir Say&#305;d&#305;r&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="sayi&amp;&quot; Say&#305;s&#305; Negatif Bir Say&#305;d&#305;r&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
