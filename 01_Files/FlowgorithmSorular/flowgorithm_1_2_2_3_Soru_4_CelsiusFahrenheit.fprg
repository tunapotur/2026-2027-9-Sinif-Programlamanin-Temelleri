    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="c, f" type="Real" array="False" size=""/>
            <output expression="&quot;Celsius :&quot;" newline="True"/>
            <input variable="c"/>
            <assign variable="f" expression="c*1.8 +32"/>
            <output expression="&quot;Fahrenheit :&quot;&amp;f" newline="True"/>
        </body>
    </function>
</flowgorithm>
