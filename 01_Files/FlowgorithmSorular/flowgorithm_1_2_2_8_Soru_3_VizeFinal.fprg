<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="flowgorithm_1_2_2_8_Soru_3_VizeFinal"/>
        <attribute name="authors" value="tuna"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-17 11:39:27 &#214;S"/>
        <attribute name="created" value="dHVuYTtXSU4xMVRVTkE7MjAyNi0xMC0xNzsxMDoyMDoyNSDDllM7MjUwMQ=="/>
