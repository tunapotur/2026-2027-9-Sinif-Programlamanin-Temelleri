    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vize, final, ortalama" type="Real" array="False" size=""/>
            <output expression="&quot;Vize Notunu Girin: &quot;" newline="True"/>
            <input variable="vize"/>
            <output expression="&quot;Final Notunu Girin :&quot;" newline="True"/>
            <input variable="final"/>
            <assign variable="ortalama" expression="vize*0.4 + final*0.6"/>
            <if expression="ortalama &gt;= 50">
                <then>
                    <output expression="&quot;Ge&#231;tiniz Tebrikler! Ortalaman&#305;z: &quot;&amp;ortalama" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Kald&#305;n&#305;z! Ortalaman&#305;z: &quot;&amp;ortalama" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
