    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="taksiMetreAcilisTutar, kilometreBasiTutar, kilometreYol, odenecekTutar" type="Real" array="False" size=""/>
            <assign variable="taksiMetreAcilisTutar" expression="30"/>
            <assign variable="kilometreBasiTutar" expression="20"/>
            <output expression="&quot;Gidilen Kilometre :&quot;" newline="True"/>
            <input variable="kilometreYol"/>
            <assign variable="odenecekTutar" expression="taksimetreAcilisTutar + kilometreYol*kilometreBasiTutar"/>
            <output expression="&quot;&#214;denecek Tutar :&quot;&amp;odenecekTutar" newline="True"/>
        </body>
    </function>
</flowgorithm>
