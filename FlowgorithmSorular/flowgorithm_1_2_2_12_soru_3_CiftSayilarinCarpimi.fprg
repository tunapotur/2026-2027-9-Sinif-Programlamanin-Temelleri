<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="flowgorithm_1_2_2_12_soru_3_CiftSayilarinCarpimi"/>
        <attribute name="authors" value="tuna"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-17 08:03:12 &#214;S"/>
        <attribute name="created" value="dHVuYTtXSU4xMVRVTkE7MjAyNi0xMC0xNzswNzo0NjoxNiDDllM7MjUxNQ=="/>
        <attribute name="edited" value="dHVuYTtXSU4xMVRVTkE7MjAyNi0xMC0xNzswODowMzoxMiDDllM7MjsyNjE0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N, carpim, sayac" type="Integer" array="False" size=""/>
            <assign variable="sayac" expression="2"/>
            <assign variable="carpim" expression="1"/>
            <output expression="&quot;N degerini Girin: &quot;" newline="True"/>
            <input variable="N"/>
            <while expression="sayac &lt;= N">
                <output expression="&quot;&#304;slem :&quot;&amp;sayac&amp;&quot; * &quot;&amp;carpim" newline="True"/>
                <assign variable="carpim" expression="carpim*sayac"/>
                <output expression="&quot;Carpma Sonuc :&quot;&amp;carpim" newline="True"/>
                <output expression="&quot;----&quot;" newline="True"/>
                <assign variable="sayac" expression="sayac + 2"/>
            </while>
            <output expression="&quot;Sonuc :&quot;&amp;carpim" newline="True"/>
        </body>
    </function>
</flowgorithm>
