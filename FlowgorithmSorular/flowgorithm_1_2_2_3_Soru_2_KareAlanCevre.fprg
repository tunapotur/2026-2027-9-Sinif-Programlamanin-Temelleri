    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kenar, alan, cevre" type="Real" array="False" size=""/>
            <output expression="&quot;Karenin Bir Kenar Uzunlu&#287;unu Girin: &quot;" newline="True"/>
            <input variable="kenar"/>
            <assign variable="alan" expression="kenar * kenar"/>
            <assign variable="cevre" expression="kenar * 4"/>
            <output expression="&quot;Karenin Alan&#305;: &quot;&amp;alan" newline="True"/>
            <output expression="&quot;Karenin &#199;evresi: &quot;&amp;cevre" newline="True"/>
        </body>
    </function>
