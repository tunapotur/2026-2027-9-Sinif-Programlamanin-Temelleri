    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="siparisTutar, kargoTutar, toplam" type="Real" array="False" size=""/>
            <output expression="&quot;Sipari&#351; Tutar&#305;n&#305;z&#305; Giriniz: &quot;" newline="True"/>
            <input variable="siparisTutar"/>
            <assign variable="kargoTutar" expression="50"/>
            <if expression="siparisTutar &gt;= 500">
                <then>
                    <assign variable="kargoTutar" expression="0"/>
                </then>
                <else/>
            </if>
            <assign variable="toplam" expression="siparisTutar + kargoTutar"/>
            <output expression="&quot;Sipari&#351; Bedeli: &quot;&amp;toplam" newline="True"/>
        </body>
    </function>
</flowgorithm>
